//@version=6
strategy("Gold TS v0.1", overlay = true, pyramiding = 0, process_orders_on_close = true, use_bar_magnifier = false,
     calc_on_order_fills = false, max_boxes_count = 100, max_lines_count = 200, max_labels_count = 200,
     max_polylines_count = 100)

// Gold TS v0.1 is a research baseline, not a claim of profitability.
// Every decision is made on confirmed bars. No request.security(), pivots, or lookahead are used.

// ── Inputs ────────────────────────────────────────────────────────────────────
string G_STRATEGY = "Strategy"
float rr = input.float(2.3, "Risk/Reward", minval = 0.1, step = 0.1, group = G_STRATEGY)
int fastLen = input.int(50, "Fast EMA", minval = 1, group = G_STRATEGY)
int slowLen = input.int(200, "Slow EMA", minval = 2, group = G_STRATEGY)
int structureLen = input.int(20, "Prior-range structure bars", minval = 2, group = G_STRATEGY)
float retracement = input.float(50.0, "Entry retracement (%)", minval = 0, maxval = 100, step = 5, group = G_STRATEGY) / 100.0
float zoneAtrWidth = input.float(0.10, "Entry zone half-width (ATR)", minval = 0, step = 0.05, group = G_STRATEGY)
int atrLen = input.int(14, "ATR length", minval = 1, group = G_STRATEGY)
float stopAtr = input.float(1.0, "Stop distance (ATR)", minval = 0.1, step = 0.1, group = G_STRATEGY)
int maxWait = input.int(24, "Maximum bars waiting for entry", minval = 1, group = G_STRATEGY,
     tooltip = "Baseline assumption: 24 chart bars. A setup may touch through this many bars after detection.")
int terminalBars = input.int(1, "Bars to retain terminal status", minval = 1, maxval = 20, group = G_STRATEGY)

string G_FVG = "FVG (metadata only)"
bool detectFvg = input.bool(true, "Enable FVG detection", group = G_FVG,
     tooltip = "Changes metadata only. It never filters TS setups or entries.")
bool showFvg = input.bool(true, "Show FVG confluence", group = G_FVG)
float minFvgTicks = input.float(0.0, "Minimum FVG size (ticks)", minval = 0, step = 1, group = G_FVG)

string G_DISPLAY = "Display"
bool showEntry = input.bool(true, "Show Entry", group = G_DISPLAY)
bool showSl = input.bool(true, "Show SL", group = G_DISPLAY)
bool showTp = input.bool(true, "Show TP", group = G_DISPLAY)
bool showDashboard = input.bool(true, "Show dashboard", group = G_DISPLAY)
bool showTradeCard = input.bool(true, "Show simple trade instruction", group = G_DISPLAY,
     tooltip = "Shows a large plain-language WAIT / ENTER instruction with frozen Entry, SL and TP directly on the chart.")
bool researchMode = input.bool(false, "Backtesting / Research Mode", group = G_DISPLAY)

string G_ALERTS = "Alerts"
bool lifecycleAlerts = input.bool(false, "Enable non-entry lifecycle alerts", group = G_ALERTS,
     tooltip = "OFF preserves the default VALID ENTRY-only alert() stream. ON also emits clearly labeled research lifecycle messages.")

// ── State and pure calculation modules ────────────────────────────────────────
int NO_SETUP = 0
int SETUP_FORMING_LONG = 1
int SETUP_FORMING_SHORT = 2
int ENTRY_ACTIVE_LONG = 3
int ENTRY_ACTIVE_SHORT = 4
int INVALID = 5
int EXPIRED = 6
int COMPLETED_TP = 7
int COMPLETED_SL = 8
int COMPLETED_AMBIGUOUS = 9

f_trend(float fast, float slow) =>
    int direction = fast > slow and close > fast ? 1 : fast < slow and close < fast ? -1 : 0
    direction

f_structure(int length) =>
    float priorHigh = ta.highest(high[1], length)
    float priorLow = ta.lowest(low[1], length)
    bool bullBreak = not na(priorHigh) and close > priorHigh and close[1] <= priorHigh
    bool bearBreak = not na(priorLow) and close < priorLow and close[1] >= priorLow
    [bullBreak, bearBreak, priorHigh, priorLow]

f_fvg(float minSize) =>
    // On candle 3/current: bullish low[0] > candle 1 high[2]; bearish high[0] < candle 1 low[2].
    bool bull = not na(high[2]) and low > high[2] and low - high[2] >= minSize
    bool bear = not na(low[2]) and high < low[2] and low[2] - high >= minSize
    [bull, bear]

f_geometry(int direction, float brokenLevel, float atrAtSetup) =>
    float impulse = math.abs(close - brokenLevel)
    float center = direction == 1 ? close - impulse * retracement : close + impulse * retracement
    float halfWidth = atrAtSetup * zoneAtrWidth
    float lower = center - halfWidth
    float upper = center + halfWidth
    float stop = direction == 1 ? center - atrAtSetup * stopAtr : center + atrAtSetup * stopAtr
    float risk = math.abs(center - stop)
    float target = direction == 1 ? center + risk * rr : center - risk * rr
    [center, lower, upper, stop, target, risk]

f_status_text(int s) =>
    switch s
        NO_SETUP => "⚪ NO SETUP"
        SETUP_FORMING_LONG => "🟡 LONG SETUP FORMING — WAIT"
        SETUP_FORMING_SHORT => "🟡 SHORT SETUP FORMING — WAIT"
        ENTRY_ACTIVE_LONG => "🟢 VALID LONG — ENTRY ACTIVE"
        ENTRY_ACTIVE_SHORT => "🟢 VALID SHORT — ENTRY ACTIVE"
        INVALID => "🔴 INVALID — DO NOT ENTER"
        EXPIRED => "⚪ EXPIRED — UNFILLED"
        COMPLETED_TP => "TP HIT"
        COMPLETED_SL => "SL HIT"
        => "AMBIGUOUS — SL/TP SAME BAR"

float emaFast = ta.ema(close, fastLen)
float emaSlow = ta.ema(close, slowLen)
float atr = ta.atr(atrLen)
int trend = f_trend(emaFast, emaSlow)
[bullBreak, bearBreak, priorHigh, priorLow] = f_structure(structureLen)
float minFvgSize = minFvgTicks * syminfo.mintick
[bullFvgNow, bearFvgNow] = f_fvg(minFvgSize)

var int state = NO_SETUP
var int direction = 0
var int setupBar = na
var int terminalBar = na
var int activeBar = na
var float entry = na
var float entryLower = na
var float entryUpper = na
var float stop = na
var float target = na
var float frozenRisk = na
var bool setupFvg = false
var bool entryAlertSent = false
var int allTrades = 0
var int allWins = 0
var int allLosses = 0
var int allAmbiguous = 0
var float allNetR = 0.0
var int fvgTrades = 0
var int fvgWins = 0
var int fvgLosses = 0
var float fvgNetR = 0.0
var int plainTrades = 0
var int plainWins = 0
var int plainLosses = 0
var float plainNetR = 0.0

// One-bar event pulses, used for alertcondition() and research marks.
bool evLongSetup = false
bool evShortSetup = false
bool evLongEntry = false
bool evShortEntry = false
bool evInvalid = false
bool evExpired = false
bool evTp = false
bool evSl = false
bool evAmbiguous = false

bool isForming = state == SETUP_FORMING_LONG or state == SETUP_FORMING_SHORT
bool isActive = state == ENTRY_ACTIVE_LONG or state == ENTRY_ACTIVE_SHORT

if barstate.isconfirmed
    // Terminal states remain visible briefly, then reset. No setup can be duplicated while non-idle.
    if state >= INVALID and not na(terminalBar) and bar_index - terminalBar >= terminalBars
        state := NO_SETUP
        direction := 0
        setupBar := na
        terminalBar := na
        activeBar := na
        entry := na
        entryLower := na
        entryUpper := na
        stop := na
        target := na
        frozenRisk := na
        setupFvg := false
        entryAlertSent := false

    isForming := state == SETUP_FORMING_LONG or state == SETUP_FORMING_SHORT
    isActive := state == ENTRY_ACTIVE_LONG or state == ENTRY_ACTIVE_SHORT

    if isForming
        int age = bar_index - setupBar
        bool trendOk = direction == 1 ? trend == 1 : trend == -1
        bool stopBreached = direction == 1 ? low <= stop : high >= stop
        bool expired = age > maxWait
        bool zoneTouched = age > 0 and not entryAlertSent and high >= entryLower and low <= entryUpper
        bool geometryOk = frozenRisk > syminfo.mintick and (direction == 1 ? stop < entry and target > entry : stop > entry and target < entry)

        // A stop/invalidation breach takes precedence over a zone touch on an ambiguous OHLC bar.
        if stopBreached or not trendOk or not geometryOk
            state := INVALID
            terminalBar := bar_index
            evInvalid := true
        else if expired
            state := EXPIRED
            terminalBar := bar_index
            evExpired := true
        else if zoneTouched
            // Revalidation passed. The actionable alert and conceptual activation happen once here.
            state := direction == 1 ? ENTRY_ACTIVE_LONG : ENTRY_ACTIVE_SHORT
            entryAlertSent := true
            activeBar := bar_index
            evLongEntry := direction == 1
            evShortEntry := direction == -1
            allTrades += 1
            if setupFvg
                fvgTrades += 1
            else
                plainTrades += 1
            string entryId = direction == 1 ? "TS Long" : "TS Short"
            strategy.entry(entryId, direction == 1 ? strategy.long : strategy.short, alert_message = "Gold TS valid entry")
            strategy.exit("TS Exit", from_entry = entryId, stop = stop, limit = target, alert_message = "Gold TS frozen exit")
            string payload = '{"system":"Gold TS v0.1","model":"SIGNAL_CONCEPTUAL","symbol":"' + syminfo.tickerid + '","timeframe":"' + timeframe.period +
                 '","direction":"' + (direction == 1 ? "LONG" : "SHORT") + '","projected_entry":' + str.tostring(entry, format.mintick) +
                 ',"entry_lower":' + str.tostring(entryLower, format.mintick) + ',"entry_upper":' + str.tostring(entryUpper, format.mintick) +
                 ',"sl":' + str.tostring(stop, format.mintick) + ',"tp":' + str.tostring(target, format.mintick) +
                 ',"rr":' + str.tostring(rr) + ' ,"touch_bar_close":' + str.tostring(close, format.mintick) + ' ,"fvg":"' + (setupFvg ? "YES" : "NO") + '","status":"VALID ENTRY","execution_note":"PROJECTED ENTRY IS NOT BROKER FILL"}'
            alert(payload, alert.freq_once_per_bar_close)

    else if isActive and bar_index > activeBar
        bool stopHit = direction == 1 ? low <= stop : high >= stop
        bool tpHit = direction == 1 ? high >= target : low <= target
        if stopHit and tpHit
            // Conservative integrity rule: unknown ordering is not called a win or loss.
            state := COMPLETED_AMBIGUOUS
            terminalBar := bar_index
            evAmbiguous := true
            allAmbiguous += 1
        else if stopHit
            state := COMPLETED_SL
            terminalBar := bar_index
            evSl := true
            allLosses += 1
            allNetR -= 1
            if setupFvg
                fvgLosses += 1
                fvgNetR -= 1
            else
                plainLosses += 1
                plainNetR -= 1
        else if tpHit
            state := COMPLETED_TP
            terminalBar := bar_index
            evTp := true
            allWins += 1
            allNetR += rr
            if setupFvg
                fvgWins += 1
                fvgNetR += rr
            else
                plainWins += 1
                plainNetR += rr

    // Create only on a confirmed idle bar. FVG switches affect only the frozen metadata bit.
    if state == NO_SETUP and not na(atr)
        int newDirection = trend == 1 and bullBreak ? 1 : trend == -1 and bearBreak ? -1 : 0
        if newDirection != 0
            float broken = newDirection == 1 ? priorHigh : priorLow
            [newEntry, newLower, newUpper, newStop, newTarget, newRisk] = f_geometry(newDirection, broken, atr)
            bool validGeometry = newRisk > syminfo.mintick and (newDirection == 1 ? newStop < newEntry and newTarget > newEntry : newStop > newEntry and newTarget < newEntry)
            if validGeometry
                direction := newDirection
                setupBar := bar_index
                entry := newEntry
                entryLower := newLower
                entryUpper := newUpper
                stop := newStop
                target := newTarget
                frozenRisk := newRisk
                setupFvg := detectFvg and (newDirection == 1 ? bullFvgNow : bearFvgNow)
                entryAlertSent := false
                state := newDirection == 1 ? SETUP_FORMING_LONG : SETUP_FORMING_SHORT
                evLongSetup := newDirection == 1
                evShortSetup := newDirection == -1

// ── Bounded chart objects: one reusable live projection set ───────────────────
var box entryBox = na
var line entryLine = na
var line slLine = na
var line tpLine = na
bool hasProjection = state == SETUP_FORMING_LONG or state == SETUP_FORMING_SHORT or state == ENTRY_ACTIVE_LONG or state == ENTRY_ACTIVE_SHORT
color directionColor = direction == 1 ? color.teal : color.orange
if barstate.islast
    if hasProjection
        if showEntry
            if na(entryBox)
                entryBox := box.new(setupBar, entryUpper, bar_index + 1, entryLower, bgcolor = color.new(directionColor, 82), border_color = directionColor, extend = extend.right)
                entryLine := line.new(setupBar, entry, bar_index + 1, entry, color = directionColor, style = line.style_dashed, extend = extend.right)
            else
                box.set_lefttop(entryBox, setupBar, entryUpper), box.set_rightbottom(entryBox, bar_index + 1, entryLower), box.set_bgcolor(entryBox, color.new(directionColor, 82)), box.set_border_color(entryBox, directionColor)
                line.set_xy1(entryLine, setupBar, entry), line.set_xy2(entryLine, bar_index + 1, entry), line.set_color(entryLine, directionColor)
        else
            if not na(entryBox)
                box.delete(entryBox), entryBox := na
            if not na(entryLine)
                line.delete(entryLine), entryLine := na
        if showSl
            if na(slLine)
                slLine := line.new(setupBar, stop, bar_index + 1, stop, color = color.red, width = 2, extend = extend.right)
            else
                line.set_xy1(slLine, setupBar, stop), line.set_xy2(slLine, bar_index + 1, stop)
        else if not na(slLine)
            line.delete(slLine), slLine := na
        if showTp
            if na(tpLine)
                tpLine := line.new(setupBar, target, bar_index + 1, target, color = color.lime, width = 2, extend = extend.right)
            else
                line.set_xy1(tpLine, setupBar, target), line.set_xy2(tpLine, bar_index + 1, target)
        else if not na(tpLine)
            line.delete(tpLine), tpLine := na
    else
        if not na(entryBox)
            box.delete(entryBox), entryBox := na
        if not na(entryLine)
            line.delete(entryLine), entryLine := na
        if not na(slLine)
            line.delete(slLine), slLine := na
        if not na(tpLine)
            line.delete(tpLine), tpLine := na

// ── Plain-language live trade instruction ─────────────────────────────────────
// This is display-only. It does not alter setup detection, revalidation, entries, exits, alerts, or statistics.
var label tradeCard = na
f_trade_instruction() =>
    string zoneText = (na(entryLower) ? "—" : str.tostring(entryLower, format.mintick)) + "–" + (na(entryUpper) ? "—" : str.tostring(entryUpper, format.mintick))
    string levelsText = "ENTRY " + zoneText + "  |  SL " + (na(stop) ? "—" : str.tostring(stop, format.mintick)) + "  |  TP " + (na(target) ? "—" : str.tostring(target, format.mintick))
    bool activationBar = (state == ENTRY_ACTIVE_LONG or state == ENTRY_ACTIVE_SHORT) and bar_index == activeBar
    string instruction = state == SETUP_FORMING_LONG ? "WAIT — LONG SETUP FORMING\n" + levelsText :
         state == SETUP_FORMING_SHORT ? "WAIT — SHORT SETUP FORMING\n" + levelsText :
         state == ENTRY_ACTIVE_LONG and activationBar ? "LONG — ENTER NOW\n" + levelsText :
         state == ENTRY_ACTIVE_SHORT and activationBar ? "SHORT — ENTER NOW\n" + levelsText :
         state == ENTRY_ACTIVE_LONG ? "LONG — TRADE ACTIVE\nORIGINAL " + levelsText + "\nDO NOT OPEN A NEW TRADE" :
         state == ENTRY_ACTIVE_SHORT ? "SHORT — TRADE ACTIVE\nORIGINAL " + levelsText + "\nDO NOT OPEN A NEW TRADE" :
         state == INVALID ? "INVALID — DO NOT ENTER" :
         state == EXPIRED ? "EXPIRED — DO NOT ENTER" :
         ""
    instruction

if barstate.islast
    string tradeInstruction = f_trade_instruction()
    bool showInstructionNow = showTradeCard and str.length(tradeInstruction) > 0
    if showInstructionNow
        float cardY = hasProjection ? entry : close
        color cardColor = state == ENTRY_ACTIVE_LONG or state == ENTRY_ACTIVE_SHORT ? color.lime :
             state == SETUP_FORMING_LONG or state == SETUP_FORMING_SHORT ? color.yellow :
             state == INVALID ? color.red : color.gray
        color cardTextColor = state == ENTRY_ACTIVE_LONG or state == ENTRY_ACTIVE_SHORT ? color.black : color.black
        if na(tradeCard)
            tradeCard := label.new(bar_index + 2, cardY, tradeInstruction, xloc = xloc.bar_index, yloc = yloc.price,
                 style = label.style_label_left, color = cardColor, textcolor = cardTextColor, size = size.large)
        else
            label.set_xy(tradeCard, bar_index + 2, cardY)
            label.set_text(tradeCard, tradeInstruction)
            label.set_color(tradeCard, cardColor)
            label.set_textcolor(tradeCard, cardTextColor)
            label.set_size(tradeCard, size.large)
    else if not na(tradeCard)
        label.delete(tradeCard)
        tradeCard := na

// Research marks are plots, not unbounded drawing objects.
plotshape(researchMode and evLongSetup, "Long TS setup", shape.triangleup, location.belowbar, color.yellow, size = size.tiny, text = "TS")
plotshape(researchMode and evShortSetup, "Short TS setup", shape.triangledown, location.abovebar, color.yellow, size = size.tiny, text = "TS")
plotshape(researchMode and (evLongEntry or evShortEntry), "Entry activated", shape.circle, location.belowbar, color.lime, size = size.tiny)
plotshape(researchMode and evInvalid, "Invalid", shape.xcross, location.abovebar, color.red, size = size.tiny)
plotshape(researchMode and evExpired, "Expired", shape.xcross, location.abovebar, color.gray, size = size.tiny)
plotshape(researchMode and evTp, "TP", shape.diamond, location.abovebar, color.lime, size = size.tiny)
plotshape(researchMode and evSl, "SL", shape.diamond, location.belowbar, color.red, size = size.tiny)
plotshape(researchMode and evAmbiguous, "Ambiguous", shape.square, location.abovebar, color.orange, size = size.tiny)

// ── Compact dashboard and research segmentation ───────────────────────────────
var table dash = table.new(position.top_right, 2, 13, bgcolor = color.new(color.black, 15), frame_color = color.gray, frame_width = 1)
f_price(float value) => na(value) ? "—" : str.tostring(value, format.mintick)
f_rate(int wins, int losses) => wins + losses == 0 ? "—" : str.tostring(100.0 * wins / (wins + losses), "#.0") + "%"
if barstate.islast
    if showDashboard
        table.cell(dash, 0, 0, "GOLD TS", text_color = color.yellow), table.cell(dash, 1, 0, "v0.1 RESEARCH", text_color = color.silver)
        table.cell(dash, 0, 1, "Trend"), table.cell(dash, 1, 1, trend == 1 ? "BULLISH" : trend == -1 ? "BEARISH" : "NEUTRAL")
        table.cell(dash, 0, 2, "Status"), table.cell(dash, 1, 2, f_status_text(state), text_color = state == INVALID ? color.red : state == SETUP_FORMING_LONG or state == SETUP_FORMING_SHORT ? color.yellow : state == ENTRY_ACTIVE_LONG or state == ENTRY_ACTIVE_SHORT ? color.lime : color.white)
        table.cell(dash, 0, 3, "Direction"), table.cell(dash, 1, 3, direction == 1 ? "LONG" : direction == -1 ? "SHORT" : "—")
        table.cell(dash, 0, 4, "Entry zone"), table.cell(dash, 1, 4, hasProjection ? f_price(entryLower) + "–" + f_price(entryUpper) : "—")
        table.cell(dash, 0, 5, "SL"), table.cell(dash, 1, 5, hasProjection ? f_price(stop) : "—")
        table.cell(dash, 0, 6, "TP"), table.cell(dash, 1, 6, hasProjection ? f_price(target) : "—")
        table.cell(dash, 0, 7, "R:R"), table.cell(dash, 1, 7, "1:" + str.tostring(rr))
        table.cell(dash, 0, 8, "FVG"), table.cell(dash, 1, 8, hasProjection and showFvg and setupFvg ? "YES — CONFLUENCE" : "—")
        if researchMode
            table.cell(dash, 0, 9, "Conceptual All TS"), table.cell(dash, 1, 9, str.tostring(allTrades) + " | " + str.tostring(allWins) + "W/" + str.tostring(allLosses) + "L | " + f_rate(allWins, allLosses) + " | " + str.tostring(allNetR, "#.##") + "R")
            table.cell(dash, 0, 10, "Conceptual TS + FVG"), table.cell(dash, 1, 10, str.tostring(fvgTrades) + " | " + str.tostring(fvgWins) + "W/" + str.tostring(fvgLosses) + "L | " + f_rate(fvgWins, fvgLosses) + " | " + str.tostring(fvgNetR, "#.##") + "R")
            table.cell(dash, 0, 11, "Conceptual TS no FVG"), table.cell(dash, 1, 11, str.tostring(plainTrades) + " | " + str.tostring(plainWins) + "W/" + str.tostring(plainLosses) + "L | " + f_rate(plainWins, plainLosses) + " | " + str.tostring(plainNetR, "#.##") + "R")
            table.cell(dash, 0, 12, "Conceptual ambiguous"), table.cell(dash, 1, 12, str.tostring(allAmbiguous))
        else
            for row = 9 to 12
                table.cell(dash, 0, row, ""), table.cell(dash, 1, row, "")
    else
        table.clear(dash, 0, 0, 1, 12)

// A strategy cannot expose usable alertcondition() triggers; alertcondition() only has effect in indicators.
// The default alert() stream therefore contains VALID ENTRY only. Optional lifecycle alerts are explicitly
// opt-in research messages and never call an invalid/forming setup a valid entry.
if lifecycleAlerts and barstate.isconfirmed
    string lifecycleEvent = evLongSetup ? "FORMING_LONG_NOT_ACTIONABLE" : evShortSetup ? "FORMING_SHORT_NOT_ACTIONABLE" : evInvalid ? "INVALID_DO_NOT_ENTER" : evExpired ? "EXPIRED_UNFILLED" : evTp ? "CONCEPTUAL_TP" : evSl ? "CONCEPTUAL_SL" : evAmbiguous ? "CONCEPTUAL_AMBIGUOUS" : ""
    if str.length(lifecycleEvent) > 0
        string lifecyclePayload = '{"system":"Gold TS v0.1","model":"SIGNAL_CONCEPTUAL","symbol":"' + syminfo.tickerid + '","timeframe":"' + timeframe.period + '","event":"' + lifecycleEvent + '","actionable":false}'
        alert(lifecyclePayload, alert.freq_once_per_bar_close)
