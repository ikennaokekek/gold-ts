//@version=6
strategy("Gold TS v0.1", overlay = true, pyramiding = 0, process_orders_on_close = true, use_bar_magnifier = false,
     calc_on_order_fills = false, max_boxes_count = 100, max_lines_count = 200, max_labels_count = 200)

// Gold TS v0.1 is a research baseline, not a claim of profitability.
// Every decision is made on confirmed bars. No request.security(), pivots, or lookahead are used.

// ── Inputs ────────────────────────────────────────────────────────────────────
// Locked forward-demo values; no optimization controls in trader settings.
const float rr = 2.3
const int fastLen = 50
const int slowLen = 200
const int structureLen = 20
const float retracement = 0.50
const float zoneAtrWidth = 0.10
const int atrLen = 14
const float stopAtr = 1.0
const int maxWait = 24
const int terminalBars = 1

// Informational only: these never set order quantity or enforce account-wide risk.
const float referenceAccount = 200000.0
const float plannedRiskPct = 0.25
const float referenceRisk = referenceAccount * plannedRiskPct / 100.0
const float internalDailyLossPct = 2.0
const float internalDailyLossLimit = referenceAccount * internalDailyLossPct / 100.0
const string riskPlanningText = "PLANNED RISK: 0.25% / $500 MAX | $200,000 REFERENCE ONLY | SIZE EXTERNALLY"
const string dailyPlanningText = "2% / $4,000 | EXTERNAL PORTFOLIO CONTROL"

string G_FVG = "FVG (metadata only)"
bool detectFvg = input.bool(true, "Enable FVG detection", group = G_FVG,
     tooltip = "Changes metadata only. It never filters TS setups or entries.")
bool showFvg = input.bool(true, "Show FVG confluence", group = G_FVG)
float minFvgTicks = input.float(0.0, "Minimum FVG size (ticks)", minval = 0, step = 1, group = G_FVG)

string G_DISPLAY = "Display"
bool showEntry = input.bool(true, "Show Entry", group = G_DISPLAY)
bool showSl = input.bool(true, "Show SL", group = G_DISPLAY)
bool showTp = input.bool(true, "Show TP", group = G_DISPLAY)
bool showDashboard = input.bool(true, "Show dashboard", group = G_DISPLAY)
bool showTradeCard = input.bool(true, "Show trade card", group = G_DISPLAY,
     tooltip = "Shows a compact card beside the current setup with its frozen entry range, SL and TP.")
bool researchMode = input.bool(false, "Backtesting / Research Mode", group = G_DISPLAY)
int researchTradesToShow = input.int(40, "Historical trades to show", minval = 1, maxval = 60, group = G_DISPLAY,
     tooltip = "Research Mode only. Shows BUY/SELL, Entry zone, SL and TP for the most recent conceptual trades.")

string G_ALERTS = "Alerts"
bool lifecycleAlerts = input.bool(false, "Enable non-entry lifecycle alerts", group = G_ALERTS,
     tooltip = "OFF preserves the default VALID ENTRY-only alert() stream. ON also emits clearly labeled research lifecycle messages.")

// ── State and pure calculation modules ────────────────────────────────────────
int NO_SETUP = 0
int SETUP_FORMING_LONG = 1
int SETUP_FORMING_SHORT = 2
int ENTRY_ACTIVE_LONG = 3
int ENTRY_ACTIVE_SHORT = 4
int INVALID = 5
int EXPIRED = 6
int COMPLETED_TP = 7
int COMPLETED_SL = 8
int COMPLETED_AMBIGUOUS = 9

f_trend(float fast, float slow) =>
    int direction = fast > slow and close > fast ? 1 : fast < slow and close < fast ? -1 : 0
    direction

f_structure(int length) =>
    float priorHigh = ta.highest(high[1], length)
    float priorLow = ta.lowest(low[1], length)
    bool bullBreak = not na(priorHigh) and close > priorHigh and close[1] <= priorHigh
    bool bearBreak = not na(priorLow) and close < priorLow and close[1] >= priorLow
    [bullBreak, bearBreak, priorHigh, priorLow]

f_fvg(float minSize) =>
    // On candle 3/current: bullish low[0] > candle 1 high[2]; bearish high[0] < candle 1 low[2].
    bool bull = not na(high[2]) and low > high[2] and low - high[2] >= minSize
    bool bear = not na(low[2]) and high < low[2] and low[2] - high >= minSize
    [bull, bear]

f_geometry(int direction, float brokenLevel, float atrAtSetup) =>
    float impulse = math.abs(close - brokenLevel)
    float center = direction == 1 ? close - impulse * retracement : close + impulse * retracement
    float halfWidth = atrAtSetup * zoneAtrWidth
    float lower = center - halfWidth
    float upper = center + halfWidth
    float stop = direction == 1 ? center - atrAtSetup * stopAtr : center + atrAtSetup * stopAtr
    float risk = math.abs(center - stop)
    float target = direction == 1 ? center + risk * rr : center - risk * rr
    [center, lower, upper, stop, target, risk]

f_status_text(int s) =>
    switch s
        NO_SETUP => "⚪ NO SETUP"
        SETUP_FORMING_LONG => "🟡 LONG SETUP FORMING — WAIT"
        SETUP_FORMING_SHORT => "🟡 SHORT SETUP FORMING — WAIT"
        ENTRY_ACTIVE_LONG => "🟢 VALID LONG — ENTRY ACTIVE"
        ENTRY_ACTIVE_SHORT => "🟢 VALID SHORT — ENTRY ACTIVE"
        INVALID => "🔴 INVALID — DO NOT ENTER"
        EXPIRED => "⚪ EXPIRED — UNFILLED"
        COMPLETED_TP => "TP HIT"
        COMPLETED_SL => "SL HIT"
        => "AMBIGUOUS — SL/TP SAME BAR"

float emaFast = ta.ema(close, fastLen)
float emaSlow = ta.ema(close, slowLen)
float atr = ta.atr(atrLen)
int trend = f_trend(emaFast, emaSlow)
[bullBreak, bearBreak, priorHigh, priorLow] = f_structure(structureLen)
float minFvgSize = minFvgTicks * syminfo.mintick
[bullFvgNow, bearFvgNow] = f_fvg(minFvgSize)

var int state = NO_SETUP
var int direction = 0
var int setupBar = na
var int terminalBar = na
var int activeBar = na
var float entry = na
var float entryLower = na
var float entryUpper = na
var float stop = na
var float target = na
var float frozenRisk = na
var bool setupFvg = false
var bool entryAlertSent = false
var int allTrades = 0
var int allWins = 0
var int allLosses = 0
var int allAmbiguous = 0
var float allNetR = 0.0
var int fvgTrades = 0
var int fvgWins = 0
var int fvgLosses = 0
var float fvgNetR = 0.0
var int plainTrades = 0
var int plainWins = 0
var int plainLosses = 0
var float plainNetR = 0.0

// Research-only historical trade drawings. These arrays are display state only.
var array<box> historyEntryBoxes = array.new<box>()
var array<line> historyEntryLines = array.new<line>()
var array<line> historySlLines = array.new<line>()
var array<line> historyTpLines = array.new<line>()
var array<label> historyLabels = array.new<label>()
var array<string> historyBaseTexts = array.new<string>()

// One-bar event pulses for alert() lifecycle messages and research marks.
bool evLongSetup = false
bool evShortSetup = false
bool evLongEntry = false
bool evShortEntry = false
bool evInvalid = false
bool evExpired = false
bool evTp = false
bool evSl = false
bool evAmbiguous = false

bool isForming = state == SETUP_FORMING_LONG or state == SETUP_FORMING_SHORT
bool isActive = state == ENTRY_ACTIVE_LONG or state == ENTRY_ACTIVE_SHORT

if barstate.isconfirmed
    // Terminal states remain visible briefly, then reset. No setup can be duplicated while non-idle.
    if state >= INVALID and not na(terminalBar) and bar_index - terminalBar >= terminalBars
        state := NO_SETUP
        direction := 0
        setupBar := na
        terminalBar := na
        activeBar := na
        entry := na
        entryLower := na
        entryUpper := na
        stop := na
        target := na
        frozenRisk := na
        setupFvg := false
        entryAlertSent := false

    isForming := state == SETUP_FORMING_LONG or state == SETUP_FORMING_SHORT
    isActive := state == ENTRY_ACTIVE_LONG or state == ENTRY_ACTIVE_SHORT

    if isForming
        int age = bar_index - setupBar
        bool trendOk = direction == 1 ? trend == 1 : trend == -1
        bool stopBreached = direction == 1 ? low <= stop : high >= stop
        bool expired = age > maxWait
        bool zoneTouched = age > 0 and not entryAlertSent and high >= entryLower and low <= entryUpper
        bool geometryOk = frozenRisk > syminfo.mintick and (direction == 1 ? stop < entry and target > entry : stop > entry and target < entry)

        // A stop/invalidation breach takes precedence over a zone touch on an ambiguous OHLC bar.
        if stopBreached or not trendOk or not geometryOk
            state := INVALID
            terminalBar := bar_index
            evInvalid := true
        else if expired
            state := EXPIRED
            terminalBar := bar_index
            evExpired := true
        else if zoneTouched
            // Revalidation passed. The actionable alert and conceptual activation happen once here.
            state := direction == 1 ? ENTRY_ACTIVE_LONG : ENTRY_ACTIVE_SHORT
            entryAlertSent := true
            activeBar := bar_index
            evLongEntry := direction == 1
            evShortEntry := direction == -1
            // Research Mode: preserve the frozen conceptual trade plan on the historical chart.
            // This does not affect entries, exits, alerts, statistics, or state transitions.
            if researchMode
                color histColor = direction == 1 ? color.teal : color.orange
                box histBox = box.new(activeBar, entryUpper, activeBar + 1, entryLower, bgcolor = color.new(histColor, 84), border_color = histColor, extend = extend.none)
                line histEntry = line.new(activeBar, entry, activeBar + 1, entry, color = histColor, style = line.style_dashed, width = 1)
                line histSl = line.new(activeBar, stop, activeBar + 1, stop, color = color.red, width = 2)
                line histTp = line.new(activeBar, target, activeBar + 1, target, color = color.lime, width = 2)
                string histZone = str.tostring(entryLower, format.mintick) + "–" + str.tostring(entryUpper, format.mintick)
                string histText = (direction == 1 ? "BUY GOLD" : "SELL GOLD") + "\nENTRY: " + histZone + "\nSL: " + str.tostring(stop, format.mintick) + "\nTP: " + str.tostring(target, format.mintick)
                label histLabel = label.new(activeBar, direction == 1 ? entryLower : entryUpper, histText, xloc = xloc.bar_index, yloc = yloc.price,
                     style = direction == 1 ? label.style_label_up : label.style_label_down, textalign = text.align_left, color = histColor, textcolor = color.white, size = size.small)
                array.push(historyEntryBoxes, histBox)
                array.push(historyEntryLines, histEntry)
                array.push(historySlLines, histSl)
                array.push(historyTpLines, histTp)
                array.push(historyLabels, histLabel)
                array.push(historyBaseTexts, histText)
                if array.size(historyLabels) > researchTradesToShow
                    box.delete(array.shift(historyEntryBoxes))
                    line.delete(array.shift(historyEntryLines))
                    line.delete(array.shift(historySlLines))
                    line.delete(array.shift(historyTpLines))
                    label.delete(array.shift(historyLabels))
                    array.shift(historyBaseTexts)
            allTrades += 1
            if setupFvg
                fvgTrades += 1
            else
                plainTrades += 1
            string entryId = direction == 1 ? "TS Long" : "TS Short"
            strategy.entry(entryId, direction == 1 ? strategy.long : strategy.short, alert_message = "Gold TS valid entry")
            strategy.exit("TS Exit", from_entry = entryId, stop = stop, limit = target, alert_message = "Gold TS frozen exit")
            string payload = '{"system":"Gold TS v0.1","model":"SIGNAL_CONCEPTUAL","symbol":"' + syminfo.tickerid + '","timeframe":"' + timeframe.period +
                 '","direction":"' + (direction == 1 ? "LONG" : "SHORT") + '","projected_entry":' + str.tostring(entry, format.mintick) +
                 ',"entry_lower":' + str.tostring(entryLower, format.mintick) + ',"entry_upper":' + str.tostring(entryUpper, format.mintick) +
                 ',"sl":' + str.tostring(stop, format.mintick) + ',"tp":' + str.tostring(target, format.mintick) +
                 ',"rr":' + str.tostring(rr) + ' ,"touch_bar_close":' + str.tostring(close, format.mintick) +
                 ',"action":"' + (direction == 1 ? "BUY" : "SELL") + '","market_revalidation_price":' + str.tostring(close, format.mintick) +
                 ',"projected_risk_distance":' + str.tostring(frozenRisk, format.mintick) + ',"market_to_sl_distance":' + str.tostring(math.abs(close - stop), format.mintick) +
                 ',"reference_account_usd":' + str.tostring(referenceAccount) + ',"planned_risk_pct":' + str.tostring(plannedRiskPct) +
                 ',"planned_max_normal_loss_usd":' + str.tostring(referenceRisk) + ',"internal_daily_loss_pct":' + str.tostring(internalDailyLossPct) +
                 ',"internal_daily_loss_limit_usd":' + str.tostring(internalDailyLossLimit) + ',"risk_control":"EXTERNAL_MANUAL_PORTFOLIO","automatic_position_sizing":false,"actionable":true,"fvg":"' + (setupFvg ? "YES" : "NO") + '","status":"VALID ENTRY","execution_note":"PROJECTED ENTRY IS NOT BROKER FILL"}'
            alert(payload, alert.freq_once_per_bar_close)

    else if isActive and bar_index > activeBar
        bool stopHit = direction == 1 ? low <= stop : high >= stop
        bool tpHit = direction == 1 ? high >= target : low <= target
        if stopHit and tpHit
            // Conservative integrity rule: unknown ordering is not called a win or loss.
            state := COMPLETED_AMBIGUOUS
            if researchMode and array.size(historyLabels) > 0
                int histLast = array.size(historyLabels) - 1
                label.set_text(array.get(historyLabels, histLast), array.get(historyBaseTexts, histLast) + "\n⚠ RESULT: AMBIGUOUS")
            if researchMode and array.size(historyEntryLines) > 0
                line.set_x2(array.get(historyEntryLines, array.size(historyEntryLines) - 1), bar_index)
                line.set_x2(array.get(historySlLines, array.size(historySlLines) - 1), bar_index)
                line.set_x2(array.get(historyTpLines, array.size(historyTpLines) - 1), bar_index)
                box.set_right(array.get(historyEntryBoxes, array.size(historyEntryBoxes) - 1), bar_index)
            terminalBar := bar_index
            evAmbiguous := true
            allAmbiguous += 1
        else if stopHit
            state := COMPLETED_SL
            if researchMode and array.size(historyLabels) > 0
                int histLast = array.size(historyLabels) - 1
                label.set_text(array.get(historyLabels, histLast), array.get(historyBaseTexts, histLast) + "\n❌ RESULT: SL HIT (-1R)")
            if researchMode and array.size(historyEntryLines) > 0
                line.set_x2(array.get(historyEntryLines, array.size(historyEntryLines) - 1), bar_index)
                line.set_x2(array.get(historySlLines, array.size(historySlLines) - 1), bar_index)
                line.set_x2(array.get(historyTpLines, array.size(historyTpLines) - 1), bar_index)
                box.set_right(array.get(historyEntryBoxes, array.size(historyEntryBoxes) - 1), bar_index)
            terminalBar := bar_index
            evSl := true
            allLosses += 1
            allNetR -= 1
            if setupFvg
                fvgLosses += 1
                fvgNetR -= 1
            else
                plainLosses += 1
                plainNetR -= 1
        else if tpHit
            state := COMPLETED_TP
            if researchMode and array.size(historyLabels) > 0
                int histLast = array.size(historyLabels) - 1
                label.set_text(array.get(historyLabels, histLast), array.get(historyBaseTexts, histLast) + "\n✅ RESULT: TP HIT (+" + str.tostring(rr) + "R)")
            if researchMode and array.size(historyEntryLines) > 0
                line.set_x2(array.get(historyEntryLines, array.size(historyEntryLines) - 1), bar_index)
                line.set_x2(array.get(historySlLines, array.size(historySlLines) - 1), bar_index)
                line.set_x2(array.get(historyTpLines, array.size(historyTpLines) - 1), bar_index)
                box.set_right(array.get(historyEntryBoxes, array.size(historyEntryBoxes) - 1), bar_index)
            terminalBar := bar_index
            evTp := true
            allWins += 1
            allNetR += rr
            if setupFvg
                fvgWins += 1
                fvgNetR += rr
            else
                plainWins += 1
                plainNetR += rr

    // Create only on a confirmed idle bar. FVG switches affect only the frozen metadata bit.
    if state == NO_SETUP and not na(atr)
        int newDirection = trend == 1 and bullBreak ? 1 : trend == -1 and bearBreak ? -1 : 0
        if newDirection != 0
            float broken = newDirection == 1 ? priorHigh : priorLow
            [newEntry, newLower, newUpper, newStop, newTarget, newRisk] = f_geometry(newDirection, broken, atr)
            bool validGeometry = newRisk > syminfo.mintick and (newDirection == 1 ? newStop < newEntry and newTarget > newEntry : newStop > newEntry and newTarget < newEntry)
            if validGeometry
                direction := newDirection
                setupBar := bar_index
                entry := newEntry
                entryLower := newLower
                entryUpper := newUpper
                stop := newStop
                target := newTarget
                frozenRisk := newRisk
                setupFvg := detectFvg and (newDirection == 1 ? bullFvgNow : bearFvgNow)
                entryAlertSent := false
                state := newDirection == 1 ? SETUP_FORMING_LONG : SETUP_FORMING_SHORT
                evLongSetup := newDirection == 1
                evShortSetup := newDirection == -1

// ── Bounded chart objects: one reusable live projection set ───────────────────
var box entryBox = na
var line entryLine = na
var line slLine = na
var line tpLine = na
bool hasProjection = state == SETUP_FORMING_LONG or state == SETUP_FORMING_SHORT or state == ENTRY_ACTIVE_LONG or state == ENTRY_ACTIVE_SHORT
color directionColor = direction == 1 ? color.teal : color.orange
if barstate.islast
    if hasProjection
        if showEntry
            if na(entryBox)
                entryBox := box.new(setupBar, entryUpper, bar_index + 1, entryLower, bgcolor = color.new(directionColor, 82), border_color = directionColor, extend = extend.right)
                entryLine := line.new(setupBar, entry, bar_index + 1, entry, color = directionColor, style = line.style_dashed, extend = extend.right)
            else
                box.set_lefttop(entryBox, setupBar, entryUpper), box.set_rightbottom(entryBox, bar_index + 1, entryLower), box.set_bgcolor(entryBox, color.new(directionColor, 82)), box.set_border_color(entryBox, directionColor)
                line.set_xy1(entryLine, setupBar, entry), line.set_xy2(entryLine, bar_index + 1, entry), line.set_color(entryLine, directionColor)
        else
            if not na(entryBox)
                box.delete(entryBox), entryBox := na
            if not na(entryLine)
                line.delete(entryLine), entryLine := na
        if showSl
            if na(slLine)
                slLine := line.new(setupBar, stop, bar_index + 1, stop, color = color.red, width = 2, extend = extend.right)
            else
                line.set_xy1(slLine, setupBar, stop), line.set_xy2(slLine, bar_index + 1, stop)
        else if not na(slLine)
            line.delete(slLine), slLine := na
        if showTp
            if na(tpLine)
                tpLine := line.new(setupBar, target, bar_index + 1, target, color = color.lime, width = 2, extend = extend.right)
            else
                line.set_xy1(tpLine, setupBar, target), line.set_xy2(tpLine, bar_index + 1, target)
        else if not na(tpLine)
            line.delete(tpLine), tpLine := na
    else
        if not na(entryBox)
            box.delete(entryBox), entryBox := na
        if not na(entryLine)
            line.delete(entryLine), entryLine := na
        if not na(slLine)
            line.delete(slLine), slLine := na
        if not na(tpLine)
            line.delete(tpLine), tpLine := na

// ── Plain-language live trade instruction ─────────────────────────────────────
// This is display-only. It does not alter setup detection, revalidation, entries, exits, alerts, or statistics.
var label tradeCard = na
// Display-only reference; the original entry range remains the primary instruction.
float confirmedAt = ta.valuewhen(evLongEntry or evShortEntry, close, 0)
f_trade_instruction() =>
    string zoneText = str.tostring(entryLower, format.mintick) + "–" + str.tostring(entryUpper, format.mintick)
    string levels = "\nSL: " + str.tostring(stop, format.mintick) + "\nTP: " + str.tostring(target, format.mintick) + "\nR:R: 1:" + str.tostring(rr)
    bool forming = state == SETUP_FORMING_LONG or state == SETUP_FORMING_SHORT
    bool active = state == ENTRY_ACTIVE_LONG or state == ENTRY_ACTIVE_SHORT
    bool activationBar = active and bar_index == activeBar
    string instruction = "⚪ NO SETUP"
    if forming
        instruction := (direction == 1 ? "POSSIBLE BUY — WAIT" : "POSSIBLE SELL — WAIT") + "\nENTRY: " + zoneText + levels
    else if active
        string heading = activationBar ? (direction == 1 ? "BUY GOLD — ENTER NOW" : "SELL GOLD — ENTER NOW") : (direction == 1 ? "BUY GOLD — TRADE ACTIVE" : "SELL GOLD — TRADE ACTIVE")
        instruction := heading + "\nENTRY RANGE: " + zoneText + levels + "\nRISK: 0.25% / $500 MAX" + "\nCONFIRMED AT: " + str.tostring(confirmedAt, format.mintick)
        if not activationBar
            instruction += "\nDO NOT OPEN A NEW TRADE"
    else if state == INVALID
        instruction := "INVALID — DO NOT ENTER"
    else if state == EXPIRED
        instruction := "EXPIRED — DO NOT ENTER"
    instruction

if barstate.islast
    string tradeInstruction = f_trade_instruction()
    bool showInstructionNow = showTradeCard and str.length(tradeInstruction) > 0
    if showInstructionNow
        float cardY = hasProjection ? entry : close
        color cardColor = state == ENTRY_ACTIVE_LONG or state == ENTRY_ACTIVE_SHORT ? color.lime :
             state == SETUP_FORMING_LONG or state == SETUP_FORMING_SHORT ? color.yellow :
             state == INVALID ? color.red : color.gray
        color cardTextColor = state == ENTRY_ACTIVE_LONG or state == ENTRY_ACTIVE_SHORT ? color.black : color.black
        if na(tradeCard)
            tradeCard := label.new(bar_index + 2, cardY, tradeInstruction, xloc = xloc.bar_index, yloc = yloc.price,
                 style = label.style_label_left, textalign = text.align_left, color = cardColor, textcolor = cardTextColor, size = size.small)
        else
            label.set_xy(tradeCard, bar_index + 2, cardY)
            label.set_text(tradeCard, tradeInstruction)
            label.set_color(tradeCard, cardColor)
            label.set_textcolor(tradeCard, cardTextColor)
            label.set_size(tradeCard, size.small)
    else if not na(tradeCard)
        label.delete(tradeCard)
        tradeCard := na

// Historical Research Mode plans are rendered above as plain BUY/SELL trade plans.

// ── Optional secondary dashboard and research segmentation ───────────────────────────────
f_price(float value) => na(value) ? "—" : str.tostring(value, format.mintick)
f_rate(int wins, int losses) => wins + losses == 0 ? "—" : str.tostring(100.0 * wins / (wins + losses), "#.0") + "%"

// Snapshot only confirmed engine state, never historical drawing arrays.
var int liveState = NO_SETUP
var int liveTrend = 0
var int liveDirection = 0
var int liveBar = na
var int liveActiveBar = na
var float liveLower = na
var float liveUpper = na
var float liveStop = na
var float liveTarget = na
if barstate.isconfirmed
    liveState := state
    liveTrend := trend
    liveDirection := direction
    liveBar := bar_index
    liveActiveBar := activeBar
    liveLower := entryLower
    liveUpper := entryUpper
    liveStop := stop
    liveTarget := target

// Persistent corner panel: independent of card visibility and Research Mode.
var table dash = table.new(position.top_left, 2, 11, bgcolor = color.rgb(20, 24, 30), frame_color = color.gray, frame_width = 1)
f_dash_row(int row, string title, string value, color valueColor) =>
    table.cell(dash, 0, row, title, text_color = color.silver, bgcolor = color.rgb(20, 24, 30), text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, row, value, text_color = valueColor, bgcolor = color.rgb(20, 24, 30), text_size = size.small, text_halign = text.align_left)

if barstate.islast
    table.clear(dash, 0, 0, 1, 10)
    if showDashboard
        bool liveForming = liveState == SETUP_FORMING_LONG or liveState == SETUP_FORMING_SHORT
        bool liveActive = liveState == ENTRY_ACTIVE_LONG or liveState == ENTRY_ACTIVE_SHORT
        bool liveActivation = liveActive and liveBar == liveActiveBar
        bool liveProjection = liveForming or liveActive
        string liveStatus = "NO SETUP"
        string liveAction = "WAIT"
        color liveColor = color.white
        if liveForming
            liveStatus := "FORMING — WAIT"
            liveColor := color.yellow
        else if liveActive
            liveStatus := liveActivation ? "VALID ENTRY" : "TRADE ACTIVE"
            liveAction := liveActivation ? (liveDirection == 1 ? "BUY NOW" : "SELL NOW") : "DO NOT OPEN A NEW TRADE"
            liveColor := color.lime
        else if liveState == INVALID
            liveStatus := "INVALID"
            liveAction := "DO NOT ENTER"
            liveColor := color.rgb(255, 120, 120)
        else if liveState == EXPIRED
            liveStatus := "EXPIRED"
            liveAction := "DO NOT ENTER"
        else if liveState >= COMPLETED_TP
            liveStatus := "COMPLETED — NO LIVE ENTRY"
        bool validatedTimeframe = timeframe.isminutes and timeframe.multiplier == 15
        f_dash_row(0, "GOLD TS v0.1", researchMode ? "LIVE / RESEARCH" : "LIVE", color.white)
        f_dash_row(1, "Trend", liveTrend == 1 ? "BULLISH" : liveTrend == -1 ? "BEARISH" : "NEUTRAL", color.white)
        f_dash_row(2, "Status", liveStatus, liveColor)
        f_dash_row(3, "Action", liveAction, liveColor)
        f_dash_row(4, "Entry range", liveProjection ? f_price(liveLower) + "–" + f_price(liveUpper) : "—", color.white)
        f_dash_row(5, "SL", liveProjection ? f_price(liveStop) : "—", color.white)
        f_dash_row(6, "TP", liveProjection ? f_price(liveTarget) : "—", color.white)
        f_dash_row(7, "R:R", "1:" + str.tostring(rr), color.white)
        f_dash_row(8, "Reference risk", "$500 / 0.25%", color.white)
        f_dash_row(9, "Price context", "PROJECTED ZONE / NOT BROKER FILL", color.silver)
        f_dash_row(10, "Timeframe", validatedTimeframe ? "15m" : "NOT VALIDATED ON THIS TIMEFRAME.", validatedTimeframe ? color.silver : color.yellow)

// A strategy cannot expose usable alertcondition() triggers; alertcondition() only has effect in indicators.
// The default alert() stream therefore contains VALID ENTRY only. Optional lifecycle alerts are explicitly
// opt-in research messages and never call an invalid/forming setup a valid entry.
if lifecycleAlerts and barstate.isconfirmed
    string lifecycleEvent = evLongSetup ? "FORMING_LONG_NOT_ACTIONABLE" : evShortSetup ? "FORMING_SHORT_NOT_ACTIONABLE" : evInvalid ? "INVALID_DO_NOT_ENTER" : evExpired ? "EXPIRED_UNFILLED" : evTp ? "CONCEPTUAL_TP" : evSl ? "CONCEPTUAL_SL" : evAmbiguous ? "CONCEPTUAL_AMBIGUOUS" : ""
    if str.length(lifecycleEvent) > 0
        string lifecyclePayload = '{"system":"Gold TS v0.1","model":"SIGNAL_CONCEPTUAL","symbol":"' + syminfo.tickerid + '","timeframe":"' + timeframe.period + '","event":"' + lifecycleEvent + '","actionable":false}'
        alert(lifecyclePayload, alert.freq_once_per_bar_close)
